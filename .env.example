# Google Gemini API anahtarı: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Ücretsiz katman modelleri (Google AI Studio fiyatlandırması):
#   gemini-3.1-flash-lite, gemini-3.1-flash-lite-preview, gemini-3.5-flash
# Ücretsiz DEĞİL: gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.1-flash-lite

# Veya virgülle yedekli liste (kota hatasında sırayla dener):
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.5-flash-lite

# Komut satırı logları: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG
DEBUG=true
